{
  "name": "tx-builder",
  "version": "0.11.1",
  "description": "Transaction Builder - Electron app for building Safe-compatible transaction batches",
  "main": "main.js",
  "author": {
    "name": "txbuilder",
    "email": "txbuilder@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "build": "vite build && electron-builder",
    "build:all": "vite build && electron-builder -mwl",
    "build:linux": "vite build && electron-builder --linux",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER=1 electron .\"",
    "electron": "electron .",
    "gen:rpcs": "node scripts/generate-rpcs.js",
    "gen:signatures": "node scripts/generate-signatures.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "vite": "vite",
    "vite:build": "vite build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "evm-ui": "file:../evm-ui",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ledgerhq/hw-app-eth": "^7.8.8",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@noble/curves": "^1.9.7",
    "@safe-global/api-kit": "^4.1.0",
    "@safe-global/protocol-kit": "^7.1.0",
    "@safe-global/safe-deployments": "^1.37.61",
    "@trezor/connect": "^9.7.3",
    "@trezor/connect-web": "^9.7.3",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "evmole": "^0.9.3",
    "js-sha3": "^0.9.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "protobufjs": "^7.6.5",
    "axios": "^1.19.0",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "lodash": "^4.18.1",
    "ip-address": "^10.5.0",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26"
  },
  "build": {
    "appId": "com.txbuilder.app",
    "productName": "TX Builder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "package.json",
      "src/data/safe-start-blocks.json",
      "src/data/rpcs.json",
      "src/lib/safe-scan.cjs",
      "src/addressbook-locate.cjs",
      "!**/*.map",
      "!**/*.md"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "synopsis": "Transaction Builder for Safe wallets"
    }
  }
}
